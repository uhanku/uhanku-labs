generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model WebApp {
  id          Int    @id @default(autoincrement()) @db.UnsignedInt
  name        String @unique @db.VarChar(255)
  description String @db.Text
  repoUrl     String @map("repo_url") @db.VarChar(2048)
  users       User[]

  @@map("web_apps")
}

model User {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  username String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  webappId Int    @map("webapp_id") @db.UnsignedInt
  webApp   WebApp @relation(fields: [webappId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("users")
}

model BusSchedule {
  id          Int                    @id @default(autoincrement()) @db.UnsignedInt
  importedAt  DateTime               @default(now()) @map("imported_at")
  consultedOn String                 @map("consulted_on") @db.VarChar(10)
  source      String                 @db.VarChar(255)
  title       String?                @db.VarChar(255)
  active      Boolean                @default(false)
  lines       BusLine[]
  directions  BusScheduleDirection[]

  @@map("bus_schedules")
}

model BusLine {
  id         Int           @id @default(autoincrement()) @db.UnsignedInt
  scheduleId Int           @map("schedule_id") @db.UnsignedInt
  schedule   BusSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  direction  String        @db.VarChar(64)
  dayType    String        @map("day_type") @db.VarChar(16)
  lineNo     String        @map("line_no") @db.VarChar(8)
  route      String        @db.VarChar(255)
  status     String?       @db.VarChar(255)
  departures BusDeparture[]

  @@index([scheduleId])
  @@index([direction, dayType])
  @@map("bus_lines")
}

model BusDeparture {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  lineId   Int     @map("line_id") @db.UnsignedInt
  line     BusLine @relation(fields: [lineId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  time     String  @db.VarChar(5)
  position Int

  @@index([lineId])
  @@map("bus_departures")
}

model BusScheduleDirection {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  scheduleId Int         @map("schedule_id") @db.UnsignedInt
  schedule   BusSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  direction  String      @db.VarChar(64)
  heading    String      @db.VarChar(64)
  location   String      @db.VarChar(255)
  howToRead  String      @map("how_to_read") @db.VarChar(255)

  @@index([scheduleId])
  @@unique([scheduleId, direction])
  @@map("bus_schedule_directions")
}

model BusinessDataset {
  id               Int              @id @default(autoincrement()) @db.UnsignedInt
  importedAt       DateTime         @default(now()) @map("imported_at")
  source           String           @db.VarChar(255)
  dataset          String           @db.VarChar(255)
  area             String           @db.VarChar(255)
  primarySource    String           @map("primary_source") @db.VarChar(255)
  enrichmentSource String           @map("enrichment_source") @db.VarChar(255)
  rules            Json
  counts           Json
  active           Boolean          @default(true)
  businesses       Business[]

  @@index([active, importedAt])
  @@map("business_datasets")
}

model Business {
  id                    Int                   @id @default(autoincrement()) @db.UnsignedInt
  datasetId             Int                   @map("dataset_id") @db.UnsignedInt
  dataset               BusinessDataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  key                   String                @db.VarChar(255)
  name                  String                @db.VarChar(255)
  category              String?               @db.VarChar(255)
  secondaryCategory     String?               @map("secondary_category") @db.VarChar(255)
  address               String?               @db.VarChar(1024)
  locality              String?               @db.VarChar(255)
  postalCode            String?               @map("postal_code") @db.VarChar(32)
  phone                 String?               @db.VarChar(128)
  website               String?               @db.VarChar(2048)
  rating                Float?
  reviewCount           Int?                  @map("review_count")
  hoursSummary          String?               @map("hours_summary") @db.Text
  plusCode              String?               @map("plus_code") @db.VarChar(128)
  latitude              Float?
  longitude             Float?
  notes                 Json
  googleMapsUrl         String?               @map("google_maps_url") @db.VarChar(2048)
  queriesDiscoveredVia  Json                  @map("queries_discovered_via")
  collectedAt           String?               @map("collected_at") @db.VarChar(64)
  locationMatch         String?               @map("location_match") @db.VarChar(64)
  locationReason        String?               @map("location_reason") @db.Text
  smbLikelihood         String?               @map("smb_likelihood") @db.VarChar(64)
  smbConfidence         String?               @map("smb_confidence") @db.VarChar(64)
  smbReason             String?               @map("smb_reason") @db.Text
  sources               Json
  openstreetmap         OpenStreetMapRecord[]

  @@unique([datasetId, key])
  @@index([datasetId])
  @@map("businesses")
}

model OpenStreetMapRecord {
  id                   Int             @id @default(autoincrement()) @db.UnsignedInt
  businessId           Int             @map("business_id") @db.UnsignedInt
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  osmType              String          @map("osm_type") @db.VarChar(32)
  osmId                BigInt          @map("osm_id") @db.UnsignedBigInt
  name                 String?         @db.VarChar(255)
  category             String?         @db.VarChar(255)
  address              String?         @db.VarChar(1024)
  phone                String?         @db.VarChar(128)
  website              String?         @db.VarChar(2048)
  openingHours         String?         @map("opening_hours") @db.Text
  latitude             Float?
  longitude            Float?
  osmTags              Json?           @map("osm_tags")
  matchNameSimilarity  Float?          @map("match_name_similarity")
  matchDistanceM       Float?          @map("match_distance_m")

  @@index([businessId])
  @@index([osmType, osmId])
  @@map("openstreetmap_records")
}
