COMPOSE_PROJECT_NAME=server
NGINX_PORT=80
NGINX_CONFIG=./docker/nginx/dev/nginx.conf

WEBUI_SECRET_KEY=

# Development
GENERATED_FILES_BASE_URL=http://chat.uhanku.test/generated-files

# Production should instead use something like:
# GENERATED_FILES_BASE_URL=https://chat.uhanku.com/generated-files

# Open WebUI / OpenRouter. Keep the API key only in the server-managed .env.
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENWEBUI_WEBUI_URL=http://chat.uhanku.test
OPENWEBUI_CORS_ALLOW_ORIGIN=http://chat.uhanku.test
LLM_PROVIDER=openrouter/liquid/lfm-2.5-2.6b:free

# SearXNG. Generate with: openssl rand -hex 32
SEARXNG_SECRET=

CRAWL4AI_API_TOKEN=

MYSQL_DATABASE=uhanku_labs
MYSQL_USER=uhanku
MYSQL_PASSWORD=uhanku
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
DATABASE_URL=mysql://uhanku:uhanku@localhost:3306/uhanku_labs

# Media upload authentication. Generate ADMIN_PASSWORD_HASH with:
# MEDIA_PASSWORD_INPUT='<password>' node scripts/hash-media-password.mjs
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Use a long random value, for example: openssl rand -base64 48
MEDIA_SESSION_SECRET=
MEDIA_MAX_UPLOAD_BYTES=52428800
# Chunked upload transport. Keep chunks comfortably below proxy request limits.
MEDIA_UPLOAD_CHUNK_BYTES=524288
# Incomplete upload workspaces older than this are cleaned up when media-admin/upload APIs are used.
MEDIA_UPLOAD_TEMP_MAX_AGE_MS=86400000

# Hermes agent dashboard credentials.
# UID/GID used inside the container to own files in ./.hermes (defaults to 1000).
HERMES_UID=1000
HERMES_GID=1000
HERMES_USERNAME=
HERMES_PASSWORD=
# Use a long random value, for example: openssl rand -base64 48
HERMES_AUTH_SECRET=
HERMES_API_SERVER_KEY=
